# ---------------------------------------------------------------------------
# Thridha Labs — environment variable reference (placeholders ONLY).
#
# Copy the names you need into your real `.env` file and supply real values.
# NEVER commit the real `.env`; it holds credentials. Values shown below are
# non-secret examples and must never be used for real environments.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=ThridhaLabs
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=WARNING
API_PREFIX=/api

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=thridha_labs
MONGO_TIMEOUT_MS=3000

# --- CORS (exact origins, never '*') ---
CORS_ORIGINS=http://localhost:5173

# --- Authentication / sessions ---
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_MINUTES=30
COOKIE_NAME=thridha_labs
CSRF_COOKIE_NAME=thridha_labs_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Storage ---
# Mode: 'local' (local disk) or 's3' (S3-compatible object storage).
STORAGE_MODE=local
STORAGE_LOCAL_DIR=storage-local
PRODUCT_IMAGE_MAX_BYTES=5242880
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- Media image pipeline ---
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_THUMB_SIZE=256
MEDIA_MD_SIZE=1024
MEDIA_LG_SIZE=1920

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Frontend ---
FRONTEND_URL=

# --- Certificates ---
# Canonical public origin used to build certificate verification URLs and QR
# codes. Falls back to FRONTEND_URL when blank. Must be an absolute http(s),
# non-localhost URL (issuance fails loudly otherwise).
CERTIFICATE_VERIFY_BASE_URL=

# --- AI summarization (Groq) ---
# Dedicated AES-256-GCM encryption key for the dynamic Groq API key that an
# Admin stores via the Admin Panel. MUST be a distinct, high-entropy,
# 32+ character value — never reuse JWT_SECRET. Generate one with:
#     python -m app.cli.generate_ai_key
# When blank, the Admin AI settings UI still loads but refuses to store a key
# (there is deliberately no plaintext fallback). The Groq API key itself is
# NEVER an environment variable.
AI_SETTINGS_ENCRYPTION_KEY=
# OpenAI-compatible base URL (override only to point at a proxy).
GROQ_API_BASE_URL=https://api.groq.com/openai/v1